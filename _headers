# Cloudflare Pages serves static files without running the Worker, so the
# security headers are repeated here. src/lib/server/security-headers.ts is the
# source of truth and tests/unit/security-headers.test.ts keeps this in step.
# Do not put comments inside a rule block: Cloudflare drops the headers after one.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Files in static/ have no hash in their name, so they cannot be immutable.
# One week lets repeat visits skip the request (Lighthouse: cache-insight).
/starspace-mark.png
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/built-with/*
  Cache-Control: public, max-age=604800
