{
	"name": "nebulakit-site",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"prepare": "svelte-kit sync",
		"check:bindings": "node scripts/check-bindings.mjs",
		"check:migrations": "node scripts/check-migrations.mjs",
		"setup:cf": "node scripts/setup-cf.mjs",
		"palette:scan": "bun scripts/palette-scan.mjs",
		"generate:encryption-key": "node scripts/generate-encryption-key.mjs",
		"lighthouse": "node scripts/lighthouse.mjs",
		"capture:built-with": "bun scripts/capture-built-with.mjs",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:e2e": "npm run db:migrate:local && playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:all": "npm run test && npm run test:e2e",
		"validate:contrast": "node scripts/validate-theme-contrast.cjs",
		"validate:all": "npm run check && npm run test && npm run validate:contrast",
		"update:price-index": "node scripts/update-price-index.mjs",
		"db:migrate": "node scripts/db-migrate.mjs apply",
		"db:migrate:local": "node scripts/db-migrate.mjs apply --local",
		"db:migrate:list": "node scripts/db-migrate.mjs list",
		"tunnel": "node scripts/tunnel.js",
		"dev:tunnel": "bun run dev & node scripts/tunnel.js",
		"predev": "node scripts/check-bindings.mjs --warn",
		"prebuild": "node scripts/check-bindings.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.10.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "^25.9.5",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"happy-dom": "^20.11.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"undici": "^7.29.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"wrangler": "^4.120.0"
	},
	"dependencies": {
		"@auth/core": "^0.35.0",
		"@auth/sveltekit": "^1.5.0",
		"@tiptap/core": "^2.27.2",
		"@tiptap/extension-image": "^2.27.2",
		"@tiptap/extension-link": "^2.27.2",
		"@tiptap/extension-placeholder": "^2.27.2",
		"@tiptap/pm": "^2.27.2",
		"@tiptap/starter-kit": "^2.27.2",
		"highlight.js": "^11.12.0",
		"xss": "^1.0.15"
	},
	"type": "module"
}
